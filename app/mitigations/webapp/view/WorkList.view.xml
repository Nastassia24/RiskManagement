<mvc:View controllerName="mitigations.mitigations.controller.WorkList"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
        <Table id="mitigationsList" items="{/Mitigations}">
            <headerToolbar>
                <Toolbar id="toolbar">
                    <ToolbarSpacer id="toolbarSpc"/>
                    <Button id="button" text="{ i18n>buttonText }" press="onButtonPress"></Button>
                </Toolbar>
            </headerToolbar>
            <columns>
                <Column id="clmn1">
                    <Text id="txt1" text="Name"/>
                </Column>
                <Column id="clmn2">
                    <Text id="txt2" text="Owner owner"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem id="listItem" vAlign="Middle">
                    <cells>
                        <Text id="txt3"
                            text="{descr}" />
                        <Text id="txt4"
                            text="{owner}" />
                    </cells>
                </ColumnListItem>
		    </items>
        </Table>
        
        </content>
    </Page>
</mvc:View>
